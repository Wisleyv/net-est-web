# NET-EST Frontend Environment Variables
# Copy this file to .env and customize for your environment

# ===========================
# API Configuration
# ===========================
# Development (local Docker backend)
VITE_API_BASE_URL=http://localhost:8000

# Production (Railway backend example)
# VITE_API_BASE_URL=https://netest-backend.up.railway.app

# API timeout (milliseconds)
VITE_API_TIMEOUT=120000

# ===========================
# Application Settings
# ===========================
VITE_APP_NAME=NET-EST
VITE_APP_VERSION=2.0.0

# ===========================
# Feature Flags
# ===========================
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_FEEDBACK=true
VITE_ENABLE_EXPORT=true

# ===========================
# Development
# ===========================
VITE_DEV_PORT=3000
VITE_DEV_HOST=0.0.0.0
VITE_DEBUG=true
