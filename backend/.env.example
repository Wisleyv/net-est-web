# NET-EST Backend Environment Variables
# Copy this file to .env and customize for your environment

# ===========================
# Application Settings
# ===========================
APP_NAME=NET-EST API
VERSION=2.0.0
DEBUG=True
LOG_LEVEL=INFO

# Server Configuration (Docker: use 0.0.0.0, Local: use 127.0.0.1)
HOST=0.0.0.0
PORT=8000
RELOAD=True

# ===========================
# Database Configuration
# ===========================
# Development (Docker Compose)
DATABASE_URL=postgresql+asyncpg://netest:netest_dev_password@postgres:5432/netest_dev

# Production (Railway/Neon example)
# DATABASE_URL=postgresql+asyncpg://user:password@hostname:5432/database

DATABASE_ECHO=False
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ===========================
# Redis Cache
# ===========================
# Development (Docker Compose)
REDIS_URL=redis://redis:6379/0

# Production (Upstash example)
# REDIS_URL=rediss://default:password@hostname:6379

ENABLE_REDIS_CACHE=True

# ===========================
# CORS Configuration
# ===========================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ===========================
# ML Model Configuration
# ===========================
# Primary model (mpnet recommended for balance)
BERTIMBAU_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# Alternatives:
# Fast mode: paraphrase-multilingual-MiniLM-L12-v2
# Experimental: Alibaba-NLP/gte-multilingual-base

SIMILARITY_THRESHOLD=0.5
STRATEGY_DETECTION_MODE=complete  # "complete" or "performance"
MAX_SENTENCES_FOR_PERFORMANCE=5

# ===========================
# Feature Flags
# ===========================
DEFAULT_HIERARCHICAL_OUTPUT=True

# ===========================
# File Upload
# ===========================
UPLOAD_DIR=data/uploads
ALLOWED_FILE_TYPES=txt,docx,pdf
MAX_FILE_SIZE_MB=10

# ===========================
# Processing Limits
# ===========================
MAX_WORDS_LIMIT=2000

# ===========================
# Feedback System
# ===========================
FEEDBACK_STORAGE_PATH=data/feedback
FEEDBACK_MAX_FILE_SIZE_MB=10.0

# ===========================
# Security (Production)
# ===========================
# SECRET_KEY=your-secret-key-here
# RATE_LIMIT_ENABLED=True
# REQUESTS_PER_MINUTE=60

# ===========================
# Legacy Settings (for backward compatibility)
# ===========================
# Logging
LOG_LEVEL=INFO

# Limites de processamento
MAX_WORDS_LIMIT=2000
MAX_FILE_SIZE_MB=10

# Modelos e API (para futuro uso)
BERTIMBAU_MODEL=paraphrase-multilingual-MiniLM-L12-v2
SIMILARITY_THRESHOLD=0.5
